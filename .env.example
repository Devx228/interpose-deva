# Copy to .env and fill locally. Do not commit real credentials.

# Standard OpenAI:
OPENAI_API_KEY=

# Optional for OpenAI-compatible providers:
# OPENAI_BASE_URL=https://your-provider.example/v1

# AgentDojo model name. Built-in examples:
# gpt-4o-2024-05-13
# gpt-4o-mini-2024-07-18
#
# OCI/OpenAI-compatible examples tested with tool calls:
# oci/openai.gpt-5.4-mini
# oci/openai.gpt-5.4-nano
# oci/openai.gpt-5.4
CAPGATE_AGENTDOJO_MODEL=oci/openai.gpt-5.4-mini
